    ],
    "writing_rules": {
      "style": "Problem-focused",
      "voice": "Realistic",
      "avoid": ["Exaggeration"],
      "must_include": ["Clear pain points"],
      "format": "Direct, factual paragraphs"
    },
    "agents": {
      "researcher": {
        "role": "Challenge Analyst",
        "focus": "Pain points, blockers"
      },
      "writer": {
        "role": "Challenge Writer",
        "instruction": "Clearly explain the challenges faced"
      },
      "editor": {
        "role": "Challenge Editor",
        "instruction": "Ensure accuracy and impact"
      }
    },
    "tone": "Problem-focused, realistic",
    "word_limit": 150
  },

  "Why This Service Matters": {
    "goal": "Explain how the challenges were solved",
